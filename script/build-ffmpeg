#!/usr/bin/env bash
# Builds the FFmpeg shared libraries that release builds bundle next to the
# notslack binary: decoders only (plus libvpx for VP8 with alpha), no
# programs, encoders, muxers, devices or filters, and no system libraries beyond
# zlib. libavdevice and libavfilter stay because rsmpeg links all seven libraries.
#
# Usage: script/build-ffmpeg PREFIX
# Afterwards build with PKG_CONFIG_PATH=PREFIX/lib/pkgconfig.
set -euo pipefail

FFMPEG_VERSION=n8.1.3
LIBVPX_VERSION=v1.17.0

prefix=$(mkdir -p "$1" && cd "$1" && pwd)
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
jobs=$(getconf _NPROCESSORS_ONLN)

git clone --quiet --depth 1 --branch "$LIBVPX_VERSION" https://github.com/webmproject/libvpx "$work/libvpx"
git clone --quiet --depth 1 --branch "$FFMPEG_VERSION" https://github.com/FFmpeg/FFmpeg "$work/ffmpeg"

(
    cd "$work/libvpx"
    ./configure --prefix="$prefix" --enable-pic --enable-static --disable-shared \
        --disable-examples --disable-tools --disable-docs --disable-unit-tests \
        --disable-vp8-encoder --disable-vp9-encoder
    make -j"$jobs"
    make install
)

extra_flags=()
case "$(uname -s)" in
    Darwin)
        # Let the libraries find each other next to the binary, wherever the
        # app is. On Linux, script/package sets $ORIGIN with patchelf instead.
        extra_flags+=(--install-name-dir=@rpath --extra-ldflags=-Wl,-rpath,@loader_path)
        ;;
esac

(
    cd "$work/ffmpeg"
    PKG_CONFIG_PATH="$prefix/lib/pkgconfig" ./configure --prefix="$prefix" \
        --enable-shared --disable-static --enable-pic \
        --disable-programs --disable-doc --disable-debug \
        --disable-autodetect --enable-zlib --enable-libvpx \
        --disable-encoders --disable-muxers --disable-devices --disable-filters \
        ${extra_flags[@]+"${extra_flags[@]}"}
    make -j"$jobs"
    make install
)

ls -l "$prefix/lib"
